# Token Monitor Hub — server-side environment template.
# Copy to /etc/token-monitor/hub.env (0600, root-owned) and fill in.
# Never commit real values. See deploy/README.md for the full setup.

# REQUIRED: the shared secret every client must present. High entropy:
#   openssl rand -hex 32
TOKEN_MONITOR_SECRET=

# REQUIRED: pin the hub to loopback. With a secret set the default bind host is
# 0.0.0.0; leaving this unset would expose the raw hub to the public interface.
TOKEN_MONITOR_HOST=127.0.0.1
TOKEN_MONITOR_PORT=17321

# Data location (systemd unit grants write access here).
TOKEN_MONITOR_DATA_FILE=/var/lib/token-monitor/devices.json
# Session catalog SQLite. Optional — defaults to <data dir>/<data basename>-catalog.db
# next to the device file; set explicitly to pin the name used by backup/restore.
TOKEN_MONITOR_CATALOG_FILE=/var/lib/token-monitor/devices-catalog.db
